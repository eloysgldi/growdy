# Copie para .env e preencha. O .env de verdade nunca vai para o git.

# --- BassPago ---
BASS_PIX_BASE=https://api.pix.basspago.com.br
BASS_CONTAS_BASE=https://pagamentos.basspago.com.br
BASS_CLIENT_ID=coloque-o-client-id
BASS_CLIENT_SECRET=coloque-o-client-secret
BASS_CHAVE_PIX=coloque-a-chave-pix-que-recebe

# Certificados mTLS. No Render use Secret Files: /etc/secrets/cashin.crt etc.
BASS_CERT_CASHIN=certs/cashin/BASSPAGO_41.crt
BASS_KEY_CASHIN=certs/cashin/BASSPAGO_41.key
BASS_CERT_CASHOUT=certs/cashout/BASSPAGO_41.crt
BASS_KEY_CASHOUT=certs/cashout/BASSPAGO_41.key

# --- app ---
# Só quem tem esta senha cria campanha e sobe foto. Quem abre o link não precisa de nada.
ADMIN_SENHA=escolha-uma-senha

# Onde ficam dados.json e as fotos. No Render aponte para o disco: /var/data
DADOS_DIR=dados

# DEMO=1 semeia histórico de apoios ao publicar, para a tela de demonstração
# abrir cheia (perto da meta, rifa quase esgotada). Em produção: 0.
DEMO=1

PIX_EXPIRACAO=1800
PORT=4180
